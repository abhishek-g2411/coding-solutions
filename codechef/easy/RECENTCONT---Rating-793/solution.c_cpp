#include <iostream>
#include <string>

using namespace std;

void solve() {
    int n;
    cin >> n;
    
    int start_count = 0;
    int ltime_count = 0;
    
    for (int i = 0; i < n; i++) {
        string code;
        cin >> code;
        if (code == "START38") {
            start_count++;
        } else {
            ltime_count++;
        }
    }
    
    cout << start_count << " " << ltime_count << "\n";
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}