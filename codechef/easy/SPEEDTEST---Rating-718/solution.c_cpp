#include <bits/stdc++.h>
using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        long long a, x, b, y;
        cin >> a >> x >> b >> y;
        
        // Comparing A/X and B/Y using cross-multiplication: A*Y vs B*X
        if (a * y > b * x) {
            cout << "ALICE\n";
        } else if (a * y < b * x) {
            cout << "BOB\n";
        } else {
            cout << "EQUAL\n";
        }
    }

    return 0;
}