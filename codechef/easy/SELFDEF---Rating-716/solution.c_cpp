#include <bits/stdc++.h>
using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int count = 0;
        
        for (int i = 0; i < n; i++) {
            int age;
            cin >> age;
            // Check if the age is between 10 and 60, inclusive
            if (age >= 10 && age <= 60) {
                count++;
            }
        }
        
        cout << count << "\n";
    }

    return 0;
}