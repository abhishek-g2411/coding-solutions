#include <iostream>
#include <cmath>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin >> n;

    int cum_score1 = 0, cum_score2 = 0;
    int max_lead = 0;
    int winner = 0;

    for (int i = 0; i < n; i++) {
        int s1, s2;
        cin >> s1 >> s2;

        cum_score1 += s1;
        cum_score2 += s2;

        if (cum_score1 > cum_score2) {
            int current_lead = cum_score1 - cum_score2;
            if (current_lead > max_lead) {
                max_lead = current_lead;
                winner = 1;
            }
        } else {
            int current_lead = cum_score2 - cum_score1;
            if (current_lead > max_lead) {
                max_lead = current_lead;
                winner = 2;
            }
        }
    }

    cout << winner << " " << max_lead << "\n";

    return 0;
}